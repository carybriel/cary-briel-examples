{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"title": "CEB Icon",
	"name": "ceb/icon",
	"category": "ceb",
	"icon": "star-empty",
	"description": "A selectable SVG icon with consistent sizing.",
	"textdomain": "ceb-blocks",
	"supports": {
		"html": false
	},
	"attributes": {
		"icon": {
			"type": "string",
			"default": "search"
		},
		"label": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"editorStyle": "file:./index.css"
}
